---
import { siteConfig } from '../config';
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
			<svg
				class="brand__mark"
				viewBox="0 0 58 68"
				width="18"
				height="21"
				aria-hidden="true"
			>
				<rect width="58" height="12" />
				<rect x="23" y="10" width="12" height="48" />
				<rect y="22" width="12" height="46" />
				<rect x="46" y="22" width="12" height="46" />
				<rect y="56" width="58" height="12" />
			</svg>
			<span class="brand__divider" aria-hidden="true"></span>
			<span>{siteConfig.name}.</span>
		</a>

		<nav aria-label="Primary navigation">
			<a href="/">Home</a>
			<a href="/work/">Work</a>
			<a href="/contact/">Contact</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 20;
		top: 0;
		border-bottom: 1px solid var(--grey-100);
		background: rgb(255 255 255 / 94%);
		backdrop-filter: blur(14px);
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: center;
		min-height: 5rem;
	}

	.brand {
		display: inline-flex;
		gap: 0.65rem;
		align-items: center;
		width: fit-content;
		color: var(--black);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		text-decoration: none;
	}

	.brand__mark {
		flex: 0 0 auto;
		width: 1.125rem;
		height: 1.3125rem;
		fill: currentColor;
	}

	.brand__divider {
		width: 1px;
		height: 1.3125rem;
		background: currentColor;
	}

	.site-header nav {
		display: flex;
		gap: clamp(1.2rem, 3vw, 2.25rem);
		justify-self: end;
	}

	.site-header nav a {
		color: var(--black);
		font-size: 0.78rem;
		font-weight: 650;
		text-decoration: none;
	}

	.site-header nav a {
		padding-block: 0.25rem;
		border-bottom: 1px solid transparent;
	}

	.site-header nav a:hover,
	.site-header nav a:focus-visible {
		border-color: var(--black);
	}

	@media (max-width: 700px) {
		.site-header nav {
			gap: 1rem;
		}

		.site-header nav a {
			font-size: 0.72rem;
		}
	}

	@media (max-width: 390px) {
		.site-header__inner {
			gap: 1rem;
		}
	}
</style>
