---
import { siteConfig } from '../config';

const pathname = Astro.url.pathname;

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/work/', label: 'Work' },
	{ href: '/qualifications/', label: 'Qualifications' },
	{ href: '/contact/', label: 'Contact' },
];
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
			<svg
				class="brand__mark"
				viewBox="0 0 58 68"
				width="26"
				height="30"
				aria-hidden="true"
			>
				<rect width="58" height="12" />
				<rect x="23" y="10" width="12" height="48" />
				<rect y="22" width="12" height="46" />
				<rect x="46" y="22" width="12" height="46" />
				<rect y="56" width="58" height="12" />
			</svg>
			<span class="brand__divider" aria-hidden="true"></span>
			<span>{siteConfig.name}.</span>
		</a>

		<nav class="site-nav" aria-label="Primary navigation">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class:list={{ 'is-active': isActive(link.href) }}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<button
			type="button"
			class="nav-toggle"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Open menu"
		>
			<span class="nav-toggle__box" aria-hidden="true">
				<span class="nav-toggle__line"></span>
				<span class="nav-toggle__line"></span>
			</span>
		</button>
	</div>
</header>

<div id="mobile-nav" class="mobile-nav" aria-hidden="true" inert>
	<div class="container mobile-nav__inner">
		<div class="mobile-nav__top">
			<span class="mobile-nav__label">Menu</span>
			<button type="button" class="mobile-nav__close" aria-label="Close menu">
				<span aria-hidden="true">&times;</span>
			</button>
		</div>

		<nav class="mobile-nav__links" aria-label="Mobile primary navigation">
			<ol>
				{
					navLinks.map((link, index) => (
						<li>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<a
								href={link.href}
								class:list={{ 'is-active': isActive(link.href) }}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ol>
		</nav>

		<div class="mobile-nav__footer">
			<a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
		</div>
	</div>
</div>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
	const panel = document.querySelector<HTMLElement>('#mobile-nav');
	const closeButton = document.querySelector<HTMLButtonElement>('.mobile-nav__close');

	if (toggle && panel && closeButton) {
		const mediaQuery = window.matchMedia('(min-width: 701px)');
		const panelLinks = panel.querySelectorAll('a');

		const openMenu = () => {
			panel.classList.add('is-open');
			toggle.classList.add('is-open');
			panel.removeAttribute('inert');
			panel.setAttribute('aria-hidden', 'false');
			toggle.setAttribute('aria-expanded', 'true');
			toggle.setAttribute('aria-label', 'Close menu');
			document.body.classList.add('nav-open');
			closeButton.focus();
		};

		const closeMenu = (returnFocus = true) => {
			panel.classList.remove('is-open');
			toggle.classList.remove('is-open');
			panel.setAttribute('inert', '');
			panel.setAttribute('aria-hidden', 'true');
			toggle.setAttribute('aria-expanded', 'false');
			toggle.setAttribute('aria-label', 'Open menu');
			document.body.classList.remove('nav-open');
			if (returnFocus) toggle.focus();
		};

		toggle.addEventListener('click', () => {
			panel.classList.contains('is-open') ? closeMenu() : openMenu();
		});

		closeButton.addEventListener('click', () => closeMenu());
		panelLinks.forEach((link) => link.addEventListener('click', () => closeMenu(false)));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && panel.classList.contains('is-open')) closeMenu();
		});

		mediaQuery.addEventListener('change', (event) => {
			if (event.matches) closeMenu(false);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		z-index: 40;
		top: 0;
		border-bottom: 1px solid var(--grey-100);
		background: rgb(255 255 255 / 94%);
		backdrop-filter: blur(14px);
	}

	.site-header__inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: center;
		min-height: 5rem;
	}

	.brand {
		display: inline-flex;
		gap: 0.75rem;
		align-items: center;
		width: fit-content;
		color: var(--black);
		font-size: 1.3rem;
		font-weight: 800;
		letter-spacing: -0.025em;
		text-decoration: none;
	}

	.brand__mark {
		flex: 0 0 auto;
		width: 1.625rem;
		height: 1.875rem;
		fill: currentColor;
	}

	.brand__divider {
		width: 1px;
		height: 1.875rem;
		background: currentColor;
	}

	.site-nav {
		display: flex;
		gap: clamp(1.2rem, 3vw, 2.25rem);
		justify-self: end;
	}

	.site-nav a {
		color: var(--black);
		font-size: 0.95rem;
		font-weight: 650;
		text-decoration: none;
	}

	.site-nav a {
		padding-block: 0.25rem;
		border-bottom: 1px solid transparent;
	}

	.site-nav a:hover,
	.site-nav a:focus-visible {
		border-color: var(--black);
	}

	.site-nav a.is-active {
		padding-bottom: calc(0.25rem - 1px);
		border-bottom-width: 2px;
		border-color: var(--black);
	}

	.nav-toggle {
		display: none;
		justify-self: end;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid var(--black);
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle__box {
		display: grid;
		place-items: center;
		gap: 0.35rem;
		width: 100%;
		height: 100%;
	}

	.nav-toggle__line {
		width: 1.15rem;
		height: 2px;
		background: var(--black);
		transition: transform 300ms ease, opacity 200ms ease;
	}

	.nav-toggle.is-open .nav-toggle__line:first-child {
		transform: translateY(5px) rotate(45deg);
	}

	.nav-toggle.is-open .nav-toggle__line:last-child {
		transform: translateY(-5px) rotate(-45deg);
	}

	.mobile-nav {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		visibility: hidden;
		flex-direction: column;
		background: var(--black);
		color: var(--white);
		opacity: 0;
		transform: translateX(100%);
		transition:
			transform 450ms cubic-bezier(0.65, 0, 0.35, 1),
			opacity 350ms ease,
			visibility 0s linear 450ms;
	}

	.mobile-nav.is-open {
		visibility: visible;
		opacity: 1;
		transform: translateX(0);
		transition:
			transform 450ms cubic-bezier(0.65, 0, 0.35, 1),
			opacity 350ms ease,
			visibility 0s linear 0s;
	}

	.mobile-nav__inner {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding-block: 1.5rem clamp(2.5rem, 8vw, 4rem);
	}

	.mobile-nav__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgb(255 255 255 / 25%);
	}

	.mobile-nav__label {
		color: rgb(255 255 255 / 60%);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.mobile-nav__close {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--white);
		background: transparent;
		color: var(--white);
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
	}

	.mobile-nav__links {
		display: flex;
		flex: 1;
		align-items: center;
	}

	.mobile-nav__links ol {
		width: 100%;
		list-style: none;
	}

	.mobile-nav__links li {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		padding-block: 1.1rem;
		border-bottom: 1px solid rgb(255 255 255 / 15%);
	}

	.mobile-nav__links li:first-child {
		border-top: 1px solid rgb(255 255 255 / 15%);
	}

	.mobile-nav__links li > span {
		color: rgb(255 255 255 / 45%);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.mobile-nav__links li:has(a.is-active) > span {
		color: var(--white);
	}

	.mobile-nav__links a {
		color: rgb(255 255 255 / 55%);
		font-size: clamp(2.2rem, 9vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		text-decoration: none;
		transition: color 200ms ease;
	}

	.mobile-nav__links a:hover,
	.mobile-nav__links a:focus-visible,
	.mobile-nav__links a.is-active {
		color: var(--white);
	}

	.mobile-nav__footer {
		padding-top: 1.5rem;
		border-top: 1px solid rgb(255 255 255 / 25%);
	}

	.mobile-nav__footer a {
		color: rgb(255 255 255 / 80%);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.mobile-nav__footer a:hover,
	.mobile-nav__footer a:focus-visible {
		color: var(--white);
	}

	:global(body.nav-open) {
		overflow: hidden;
	}

	@media (max-width: 700px) {
		.site-nav {
			display: none;
		}

		.nav-toggle {
			display: block;
		}
	}

	@media (min-width: 701px) {
		.mobile-nav {
			display: none;
		}
	}

	@media (max-width: 390px) {
		.site-header__inner {
			gap: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-nav,
		.mobile-nav.is-open,
		.nav-toggle__line {
			transition: none;
		}
	}
</style>
