---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<aside class="project-note">
	<p>{title}</p>
	<div><slot /></div>
</aside>

<style>
	.project-note {
		margin: 3rem 0;
		padding: 1.5rem;
		border-left: 3px solid var(--black);
		background: var(--off-white);
	}

	.project-note > p {
		margin-bottom: 0.65rem;
		color: var(--grey-500);
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-note :global(p) {
		margin: 0;
		color: var(--black);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.65;
	}
</style>
