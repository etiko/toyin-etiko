---
import { siteConfig } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact"
	description="Contact Toyin Etiko about front-end engineering, design systems and accessible digital products."
>
	<section class="contact-page">
		<div class="container contact-page__meta">
			<p>Contact</p>
			<p>Open to relevant conversations</p>
		</div>

		<div class="container contact-page__grid">
			<div class="contact-page__intro">
				<p class="eyebrow">Get in touch</p>
				<h1>Let's talk about the product you are building.</h1>

				<form
					class="contact-form"
					id="contact-form"
					method="POST"
					action={`https://formspree.io/${siteConfig.email}`}
					novalidate
				>
					<div class="contact-form__row">
						<label for="contact-name">Name</label>
						<input type="text" id="contact-name" name="name" autocomplete="name" required />
					</div>
					<div class="contact-form__row">
						<label for="contact-email">Email</label>
						<input type="email" id="contact-email" name="_replyto" autocomplete="email" required />
					</div>
					<div class="contact-form__row">
						<label for="contact-message">Message</label>
						<textarea id="contact-message" name="message" rows="5" required></textarea>
					</div>
					<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="contact-form__hp" />
					<input type="hidden" name="_subject" value="New enquiry from toyinetiko.co.uk" />
					<p class="contact-form__status" id="contact-form-status" role="status" aria-live="polite">
					</p>
					<button type="submit" class="button" id="contact-form-submit">Send message</button>
				</form>
			</div>
			<div class="contact-page__details">
				<p>
					For conversations about front-end engineering, Angular, React, Next.js or
					Astro applications, design systems or accessible interfaces, email me directly.
				</p>
				<a href={`mailto:${siteConfig.email}`}>
					<span>Email</span>
					<strong>{siteConfig.email}</strong>
					<i aria-hidden="true">&nearr;</i>
				</a>
				<a href={siteConfig.linkedin} target="_blank" rel="noreferrer">
					<span>LinkedIn</span>
					<strong>Toyin Etiko</strong>
					<i aria-hidden="true">&nearr;</i>
				</a>
				<dl>
					<div>
						<dt>Focus</dt>
						<dd>Front-end engineering, design systems and accessibility</dd>
					</div>
					<div>
						<dt>Location</dt>
						<dd>United Kingdom</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ email: siteConfig.email }}>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('contact-form-status');
	const submitButton = document.getElementById('contact-form-submit');

	function buildMailto() {
		const name = document.getElementById('contact-name').value.trim();
		const fromEmail = document.getElementById('contact-email').value.trim();
		const message = document.getElementById('contact-message').value.trim();
		const subject = `Website enquiry from ${name}`;
		const body = `${message}\n\n—\n${name}\n${fromEmail}`;
		return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		submitButton.disabled = true;
		if (status) status.textContent = 'Sending…';

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});

			if (response.ok) {
				form.reset();
				if (status) status.textContent = 'Thanks — your message has been sent. I will reply as soon as I can.';
			} else {
				throw new Error('Form submission failed');
			}
		} catch (error) {
			// Fall back to opening the visitor's email client so the message is never lost.
			window.location.href = buildMailto();
			if (status) status.textContent = 'Opening your email client to send this message…';
		} finally {
			submitButton.disabled = false;
		}
	});
</script>

<style>
	.contact-page {
		min-height: calc(100svh - 5rem);
		padding-block: 2rem clamp(6rem, 12vw, 10rem);
	}

	.contact-page__meta {
		display: flex;
		justify-content: space-between;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--black);
	}

	.contact-page__meta p {
		color: var(--grey-500);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.contact-page__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(19rem, 0.65fr);
		gap: clamp(4rem, 10vw, 10rem);
		align-items: start;
		padding-top: clamp(5rem, 10vw, 9rem);
	}

	.contact-page__intro h1 {
		max-width: 55rem;
		margin-top: 1.25rem;
		font-size: clamp(3.8rem, 8vw, 7.75rem);
		font-weight: 670;
		letter-spacing: -0.075em;
		line-height: 0.92;
	}

	.contact-form {
		display: grid;
		gap: 1.5rem;
		max-width: 34rem;
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}

	.contact-form__row {
		display: grid;
		gap: 0.5rem;
	}

	.contact-form label {
		color: var(--grey-500);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.contact-form input,
	.contact-form textarea {
		border: 1px solid var(--black);
		padding: 0.75rem 0.9rem;
		background: transparent;
		color: var(--black);
		font: inherit;
		font-size: 0.95rem;
		resize: vertical;
	}

	.contact-form input:focus-visible,
	.contact-form textarea:focus-visible {
		outline: 2px solid var(--black);
		outline-offset: 2px;
	}

	.contact-form__hp {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.contact-form__status {
		margin: 0;
		min-height: 1.2rem;
		color: var(--grey-700);
		font-size: 0.8rem;
	}

	.contact-form button {
		justify-self: start;
	}

	.contact-page__details > p {
		color: var(--grey-700);
		font-size: 1rem;
		line-height: 1.75;
	}

	.contact-page__details > a {
		position: relative;
		display: flex;
		flex-direction: column;
		margin-top: 2.5rem;
		padding: 1.15rem 3rem 1.15rem 0;
		border-top: 1px solid var(--black);
		border-bottom: 1px solid var(--black);
		color: var(--black);
		text-decoration: none;
	}

	.contact-page__details > a + a {
		margin-top: 0;
		border-top: 0;
	}

	.contact-page__details > a span {
		color: var(--grey-500);
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.contact-page__details > a strong {
		overflow: hidden;
		margin-top: 0.4rem;
		font-size: clamp(0.9rem, 1.6vw, 1.1rem);
		text-overflow: ellipsis;
	}

	.contact-page__details > a i {
		position: absolute;
		top: 50%;
		right: 0;
		font-size: 1.5rem;
		font-style: normal;
		transform: translateY(-50%);
	}

	.contact-page dl {
		display: grid;
		gap: 1.25rem;
		margin: 2.5rem 0 0;
	}

	.contact-page dl div {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 1rem;
	}

	.contact-page dt {
		color: var(--grey-500);
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.contact-page dd {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.6;
	}

	@media (max-width: 800px) {
		.contact-page__grid {
			grid-template-columns: 1fr;
		}

		.contact-page__details {
			max-width: 38rem;
		}
	}

	@media (max-width: 650px) {
		.contact-page__intro h1 {
			font-size: clamp(3.5rem, 15vw, 5.1rem);
		}
	}
</style>
