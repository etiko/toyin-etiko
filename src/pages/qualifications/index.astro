---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import bscCertificate from '../../assets/qualifications/bsc-computer-science.jpg';
import mscCertificate from '../../assets/qualifications/msc-advanced-computer-science.jpg';
import micro1Certificate from '../../assets/qualifications/micro1-ai-interview-certification.jpg';

const qualifications = [
	{
		level: 'MSc',
		title: 'Advanced Computer Science and Information Technologies Management',
		institution: 'The University of Manchester',
		year: '2010',
		detail: 'Awarded with Merit',
		certificate: mscCertificate,
		certificateAlt:
			'MSc Advanced Computer Science and Information Technologies Management certificate, The University of Manchester, awarded with Merit, 09 November 2010.',
	},
	{
		level: 'BSc',
		title: 'Computer Science',
		institution: 'University of Wolverhampton',
		year: '2009',
		detail: 'First Class Honours, including a sandwich placement',
		certificate: bscCertificate,
		certificateAlt:
			'BSc (Hons) Computer Science certificate, First Class, University of Wolverhampton, 19 June 2009.',
	},
];

const additionalCertificates = [
	{
		title: 'AI Interview Certification',
		institution: 'micro1',
		year: '2026',
		certificate: micro1Certificate,
		certificateAlt:
			"Certified by micro1 — Toyin Etiko had an outstanding performance during micro1's AI Interview, awarded 6 July 2026.",
	},
];
---

<BaseLayout
	title="Qualifications"
	description="Academic qualifications and credentials held by Toyin Etiko."
>
	<section class="qualifications-page">
		<div class="container qualifications-page__meta">
			<p>Qualifications</p>
			<p>{String(qualifications.length).padStart(2, '0')} credentials</p>
		</div>

		<div class="container qualifications-page__hero">
			<h1>Academic qualifications.</h1>
			<p>
				Formal qualifications underpinning my front-end engineering and design
				systems work.
			</p>
		</div>

		<div class="container qualifications-list">
			{
				qualifications.map((qualification, index) => (
					<article class="qualification-item">
						<header>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<span>{qualification.level}</span>
							<span>{qualification.year}</span>
						</header>

						<div class="qualification-item__grid">
							<div class="qualification-item__image">
								<div class="qualification-item__frame">
									<Image
										src={qualification.certificate}
										alt={qualification.certificateAlt}
										width={1200}
										loading="lazy"
										quality={84}
									/>
								</div>
							</div>

							<div class="qualification-item__content">
								<h3>{qualification.title}</h3>
								<p>{qualification.institution}</p>
								{qualification.detail && <p class="qualification-item__detail">{qualification.detail}</p>}
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="container qualifications-page__additional">
			<h2>Additional training</h2>
			<div class="qualifications-list">
				{
					additionalCertificates.map((item) => (
						<article class="qualification-item">
							<header>
								<span aria-hidden="true">&mdash;</span>
								<span>Certification</span>
								<span>{item.year}</span>
							</header>

							<div class="qualification-item__grid">
								<div class="qualification-item__image">
									<div class="qualification-item__frame">
										<Image
											src={item.certificate}
											alt={item.certificateAlt}
											width={1200}
											loading="lazy"
											quality={84}
										/>
									</div>
								</div>

								<div class="qualification-item__content">
									<h3>{item.title}</h3>
									<p>{item.institution}</p>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.qualifications-page {
		min-height: calc(100svh - 5rem);
		padding-block: 2rem clamp(6rem, 12vw, 10rem);
	}

	.qualifications-page__meta {
		display: flex;
		justify-content: space-between;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--black);
	}

	.qualifications-page__meta p {
		color: var(--grey-500);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.qualifications-page__hero {
		padding-top: clamp(5rem, 10vw, 9rem);
	}

	.qualifications-page__hero h1 {
		max-width: 45rem;
		font-size: clamp(3.8rem, 8vw, 7rem);
		font-weight: 670;
		letter-spacing: -0.075em;
		line-height: 0.95;
	}

	.qualifications-page__hero p {
		max-width: 34rem;
		margin-top: 1.5rem;
		color: var(--grey-700);
		font-size: clamp(1rem, 1.6vw, 1.15rem);
		line-height: 1.7;
	}

	.qualifications-list {
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.qualifications-page__additional {
		margin-top: clamp(5rem, 10vw, 8rem);
	}

	.qualifications-page__additional h2 {
		font-size: clamp(1.3rem, 2.4vw, 1.75rem);
		font-weight: 620;
		letter-spacing: -0.03em;
	}

	.qualifications-page__additional .qualifications-list {
		margin-top: 1.75rem;
	}

	.qualification-item {
		padding-block: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--black);
	}

	.qualification-item:last-child {
		border-bottom: 1px solid var(--black);
	}

	.qualification-item header {
		display: grid;
		grid-template-columns: 4rem 1fr auto;
		gap: 1rem;
		margin-bottom: 1.25rem;
		color: var(--grey-500);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.qualification-item__grid {
		display: grid;
		grid-template-columns: minmax(18rem, 0.55fr) minmax(0, 1.45fr);
		gap: clamp(2.5rem, 7vw, 6rem);
		align-items: center;
	}

	.qualification-item__image {
		display: block;
		overflow: hidden;
		background: var(--off-white);
	}

	.qualification-item__frame {
		background: var(--black);
		border-radius: 0.9rem;
		padding: 0.55rem 0.55rem 1.6rem;
		box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.18);
		clip-path: inset(0 round 0.9rem);
	}

	.qualification-item__frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.4rem;
	}

	.qualification-item h3 {
		font-size: clamp(1.5rem, 3vw, 2.4rem);
		font-weight: 690;
		letter-spacing: -0.045em;
		line-height: 1.1;
	}

	.qualification-item__content > p {
		margin-top: 1.25rem;
		color: var(--grey-700);
		font-size: 1rem;
		line-height: 1.7;
	}

	.qualification-item__detail {
		margin-top: 0.5rem !important;
		color: var(--grey-500) !important;
		font-size: 0.88rem !important;
	}

	@media (max-width: 800px) {
		.qualification-item__grid {
			grid-template-columns: 1fr;
		}

		.qualification-item__content {
			max-width: 38rem;
		}
	}

	@media (max-width: 500px) {
		.qualification-item header {
			grid-template-columns: auto 1fr;
		}

		.qualification-item header span:last-child {
			display: none;
		}
	}
</style>
