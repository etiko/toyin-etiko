---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
	<section class="not-found">
		<div class="container">
			<p>404 / Page not found</p>
			<h1>This route needs a rethink.</h1>
			<a class="button" href="/">Return home</a>
		</div>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		min-height: 70svh;
		place-items: center;
		padding-block: 5rem;
		background:
			linear-gradient(rgb(21 23 18 / 5%) 1px, transparent 1px),
			linear-gradient(90deg, rgb(21 23 18 / 5%) 1px, transparent 1px);
		background-size: 4rem 4rem;
		text-align: center;
	}

	.not-found p {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.not-found h1 {
		max-width: 55rem;
		margin: 1.5rem auto 2.5rem;
		font-size: clamp(3.3rem, 9vw, 7.25rem);
		letter-spacing: -0.075em;
		line-height: 0.9;
	}
</style>
