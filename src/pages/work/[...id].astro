---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	project: CollectionEntry<'work'>;
	nextProject: CollectionEntry<'work'>;
	totalProjects: number;
}

export async function getStaticPaths() {
	const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

	return projects.map((project, index) => ({
		params: { id: project.id },
		props: {
			project,
			nextProject: projects[(index + 1) % projects.length],
			totalProjects: projects.length,
		},
	}));
}

const { project, nextProject, totalProjects } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const projectNumber = String(data.order).padStart(2, '0');
const totalProjectsLabel = String(totalProjects).padStart(2, '0');
const leadVideoUrl = data.leadVideo
	? new URL(`https://www.youtube-nocookie.com/embed/${data.leadVideo.id}`)
	: null;

if (leadVideoUrl) {
	leadVideoUrl.searchParams.set('rel', '0');
	leadVideoUrl.searchParams.set('playsinline', '1');

	if (data.leadVideo?.startAt) {
		leadVideoUrl.searchParams.set('start', String(data.leadVideo.startAt));
	}
}

const desktopSlides = data.devicePreview
	? [
			{ src: data.devicePreview.desktop, alt: data.devicePreview.desktopAlt },
			...data.gallery.map((item) => ({ src: item.src, alt: item.alt })),
		]
	: [];
---

<BaseLayout title={`${data.title} case study`} description={data.summary}>
	<article class="case-study">
		<header class="case-hero">
			<div class="container case-hero__meta">
				<a href="/work/">&larr; All work</a>
				<span>Case study {projectNumber} / {totalProjectsLabel}</span>
				<span>{data.discipline}</span>
			</div>

			<div class="container case-hero__title">
				<div>
					<p>{data.client}</p>
					<h1>{data.title}</h1>
				</div>
				<p>{data.summary}</p>
			</div>

			<div class="container case-hero__facts">
				<dl>
					<div><dt>Role</dt><dd>{data.role}</dd></div>
					<div><dt>Engagement</dt><dd>{data.engagement}</dd></div>
					<div>
						<dt>{data.leadVideo ? 'Selected media' : 'Selected images'}</dt>
						<dd>{data.gallery.length + 1}</dd>
					</div>
				</dl>
			</div>

			<figure class="container case-hero__media">
				{
					data.leadVideo && leadVideoUrl ? (
						<div
							class="case-hero__video case-hero__video--facade"
							data-video-facade
							data-video-src={leadVideoUrl.toString()}
						>
							<Image src={data.image} alt={data.imageAlt} width={1900} quality={86} />
							<button type="button" class="case-hero__play" data-video-play>
								<span class="case-hero__play-icon" aria-hidden="true">
									&#9658;
								</span>
								<span class="sr-only">Play {data.leadVideo.title}</span>
							</button>
						</div>
					) : (
						<Image src={data.image} alt={data.imageAlt} width={1900} quality={86} />
					)
				}
			</figure>
		</header>

		<section class="case-content">
			<div class="container case-content__grid">
				<aside>
					<p>Capabilities</p>
					<ul>
						{data.tags.map((tag) => <li>{tag}</li>)}
					</ul>
				</aside>
				<div class="prose">
					<Content />
				</div>
			</div>
		</section>

		{
			data.devicePreview && (
				<section class="case-devices" aria-labelledby="devices-title">
					<div class="container case-devices__heading">
						<p class="eyebrow">On any device</p>
						<h2 id="devices-title">How it looks on your screen.</h2>
					</div>

					<div class="container case-devices__frames">
						<figure class="case-devices__desktop">
							<div class="case-devices__frame case-devices__frame--desktop">
								<div class="case-devices__carousel" data-carousel>
									{
										desktopSlides.map((slide, index) => (
											<div
												class="case-devices__slide"
												data-carousel-slide
												aria-hidden={index === 0 ? 'false' : 'true'}
											>
												<Image
													src={slide.src}
													alt={slide.alt}
													width={1400}
													loading={index === 0 ? 'eager' : 'lazy'}
													quality={84}
												/>
											</div>
										))
									}

									{
										desktopSlides.length > 1 && (
											<>
												<button
													type="button"
													class="case-devices__nav case-devices__nav--prev"
													data-carousel-prev
													aria-label="Previous screenshot"
												>
													&larr;
												</button>
												<button
													type="button"
													class="case-devices__nav case-devices__nav--next"
													data-carousel-next
													aria-label="Next screenshot"
												>
													&rarr;
												</button>
												<div class="case-devices__dots" data-carousel-dots>
													{desktopSlides.map((_, index) => (
														<span
															class="case-devices__dot"
															data-carousel-dot
															aria-hidden={index === 0 ? 'false' : 'true'}
														/>
													))}
												</div>
											</>
										)
									}
								</div>
							</div>
							<figcaption>Laptop</figcaption>
						</figure>
					</div>

					{
						data.devicePreview.mobile && data.devicePreview.tablet && (
							<div class="container case-devices__frames">
								<figure class="case-devices__phone">
									<div class="case-devices__frame case-devices__frame--phone">
										<Image
											src={data.devicePreview.mobile}
											alt={data.devicePreview.mobileAlt ?? ''}
											width={480}
											loading="lazy"
											quality={84}
										/>
									</div>
									<figcaption>Phone</figcaption>
								</figure>

								<figure class="case-devices__tablet">
									<div class="case-devices__frame case-devices__frame--tablet">
										<Image
											src={data.devicePreview.tablet}
											alt={data.devicePreview.tabletAlt ?? ''}
											width={720}
											loading="lazy"
											quality={84}
										/>
									</div>
									<figcaption>Tablet</figcaption>
								</figure>
							</div>
						)
					}
				</section>
			)
		}

		<footer class="case-next">
			<div class="container">
				<p>Next project</p>
				<a href={`/work/${nextProject.id}/`}>
					<span>{nextProject.data.title}</span>
					<i aria-hidden="true">&rarr;</i>
				</a>
			</div>
		</footer>
	</article>
</BaseLayout>

<style>
	.case-hero {
		padding-block: 2rem clamp(5rem, 10vw, 9rem);
		background: var(--white);
	}

	.case-hero__meta {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--black);
	}

	.case-hero__meta a,
	.case-hero__meta span {
		color: var(--grey-500);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.case-hero__title {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: end;
		padding-block: clamp(4rem, 8vw, 7rem);
	}

	.case-hero__title > div > p {
		margin-bottom: 0.8rem;
		color: var(--grey-500);
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.case-hero h1 {
		font-size: clamp(4.2rem, 9vw, 8.5rem);
		font-weight: 670;
		letter-spacing: -0.075em;
		line-height: 0.88;
	}

	.case-hero__title > p {
		color: var(--grey-700);
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		line-height: 1.65;
	}

	.case-hero__facts dl {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin: 0 0 clamp(3rem, 7vw, 6rem);
		padding: 1rem 0;
		border-top: 1px solid var(--black);
		border-bottom: 1px solid var(--black);
	}

	.case-hero__facts dl div {
		padding-inline: 1rem;
		border-right: 1px solid var(--grey-300);
	}

	.case-hero__facts dl div:first-child {
		padding-left: 0;
	}

	.case-hero__facts dl div:last-child {
		border-right: 0;
	}

	.case-hero__facts dt {
		color: var(--grey-500);
		font-size: 0.62rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.case-hero__facts dd {
		margin: 0.4rem 0 0;
		font-size: 0.82rem;
		font-weight: 650;
	}

	.case-hero__media {
		margin-bottom: 0;
		padding: clamp(0.5rem, 1.5vw, 1rem);
		background: var(--off-white);
	}

	.case-hero__media :global(img) {
		width: 100%;
		height: auto;
	}

	.case-hero__video {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--black);
	}

	.case-hero__video :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.case-hero__video iframe {
		width: 100%;
		height: 100%;
		border: 0;
	}

	.case-hero__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		border: 0;
		padding: 0;
		background: rgba(0, 0, 0, 0.28);
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.case-hero__play:hover,
	.case-hero__play:focus-visible {
		background: rgba(0, 0, 0, 0.4);
	}

	.case-hero__play-icon {
		display: grid;
		place-items: center;
		width: clamp(4.5rem, 8vw, 6.5rem);
		height: clamp(4.5rem, 8vw, 6.5rem);
		border-radius: 50%;
		background: var(--white);
		color: var(--black);
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		padding-left: 0.35rem;
		transition: transform 0.2s ease;
	}

	.case-hero__play:hover .case-hero__play-icon,
	.case-hero__play:focus-visible .case-hero__play-icon {
		transform: scale(1.08);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.case-content {
		padding-block: clamp(6rem, 11vw, 10rem);
		border-top: 1px solid var(--grey-100);
		background: var(--white);
	}

	.case-content__grid {
		display: grid;
		grid-template-columns: minmax(11rem, 0.35fr) minmax(0, 1fr) minmax(0, 0.2fr);
		gap: clamp(3rem, 8vw, 7rem);
	}

	.case-content aside {
		position: sticky;
		top: 8rem;
		align-self: start;
	}

	.case-content aside > p {
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--black);
		color: var(--grey-500);
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.case-content aside ul {
		display: grid;
		gap: 0.55rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.case-content aside li {
		font-size: 0.8rem;
		font-weight: 620;
	}

	.prose {
		grid-column: 2;
	}

	.prose :global(h2) {
		margin: 3.5rem 0 1rem;
		font-size: clamp(2.2rem, 4.5vw, 4rem);
		font-weight: 650;
		letter-spacing: -0.055em;
		line-height: 1;
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(li) {
		color: var(--grey-700);
		font-size: clamp(1rem, 1.6vw, 1.12rem);
		line-height: 1.85;
	}

	.prose :global(p + p) {
		margin-top: 1.15rem;
	}

	.prose :global(ul) {
		display: grid;
		gap: 0.65rem;
		margin: 1.3rem 0 0;
		padding-left: 1.2rem;
	}

	.case-devices {
		padding-block: clamp(6rem, 11vw, 10rem);
		background: var(--white);
	}

	.case-devices__heading {
		display: grid;
		grid-template-columns: 0.35fr 1.65fr;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
		margin-bottom: clamp(4rem, 8vw, 7rem);
	}

	.case-devices h2 {
		max-width: 55rem;
		font-size: clamp(2.8rem, 6vw, 5.5rem);
		font-weight: 650;
		letter-spacing: -0.065em;
		line-height: 1;
	}

	.case-devices__frames {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: center;
		gap: clamp(2rem, 6vw, 5rem);
	}

	.case-devices__frames + .case-devices__frames {
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.case-devices__frames figure {
		display: grid;
		justify-items: center;
		gap: 1rem;
		margin: 0;
	}

	.case-devices__desktop {
		width: min(100%, 980px);
	}

	.case-devices__frame {
		background: var(--black);
		box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.18);
		clip-path: inset(0 round var(--frame-radius));
	}

	.case-devices__frame--phone {
		--frame-radius: 2.2rem;
		width: clamp(190px, 22vw, 260px);
		padding: 0.6rem;
		border-radius: 2.2rem;
	}

	.case-devices__frame--tablet {
		--frame-radius: 1.4rem;
		width: clamp(280px, 32vw, 400px);
		padding: 0.7rem;
		border-radius: 1.4rem;
	}

	.case-devices__frame--desktop {
		--frame-radius: 0.9rem;
		width: min(100%, 980px);
		padding: 0.55rem 0.55rem 1.6rem;
		border-radius: 0.9rem;
	}

	.case-devices__carousel {
		position: relative;
		width: 100%;
		aspect-ratio: 1440 / 900;
		touch-action: pan-y;
	}

	.case-devices__slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.5s ease,
			visibility 0.5s ease;
	}

	.case-devices__slide[aria-hidden='false'] {
		opacity: 1;
		visibility: visible;
		z-index: 1;
	}

	.case-devices__slide :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.case-devices__nav {
		position: absolute;
		top: 50%;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		margin-top: -1.3rem;
		border: 0;
		border-radius: 50%;
		background: var(--white);
		color: var(--black);
		font-size: 1.1rem;
		cursor: pointer;
		box-shadow: 0 0.6rem 1.4rem rgba(0, 0, 0, 0.22);
		transition: transform 0.15s ease;
	}

	.case-devices__nav:hover,
	.case-devices__nav:focus-visible {
		transform: scale(1.08);
	}

	.case-devices__nav--prev {
		left: 0.75rem;
	}

	.case-devices__nav--next {
		right: 0.75rem;
	}

	.case-devices__dots {
		position: absolute;
		bottom: 0.9rem;
		left: 50%;
		z-index: 2;
		display: flex;
		gap: 0.45rem;
		transform: translateX(-50%);
	}

	.case-devices__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.45);
	}

	.case-devices__dot[aria-hidden='false'] {
		background: var(--white);
	}

	.case-devices__frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 1.4rem;
	}

	.case-devices__frame--tablet :global(img) {
		border-radius: 0.85rem;
	}

	.case-devices__frame--desktop :global(img) {
		border-radius: 0.4rem;
	}

	.case-devices__frames figcaption {
		color: var(--grey-500);
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.case-next {
		padding-block: clamp(5rem, 9vw, 8rem);
		background: var(--black);
		color: var(--white);
	}

	.case-next p {
		color: var(--grey-300);
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.case-next a {
		display: flex;
		gap: 2rem;
		align-items: center;
		justify-content: space-between;
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--white);
		color: var(--white);
		font-size: clamp(3.2rem, 8vw, 7rem);
		font-weight: 650;
		letter-spacing: -0.065em;
		line-height: 0.9;
		text-decoration: none;
	}

	.case-next a i {
		font-style: normal;
		transition: transform 180ms ease;
	}

	.case-next a:hover i,
	.case-next a:focus-visible i {
		transform: translateX(0.35rem);
	}

	@media (max-width: 800px) {
		.case-hero__title,
		.case-content__grid,
		.case-devices__heading {
			grid-template-columns: 1fr;
		}

		.case-content aside {
			position: static;
		}

		.case-content aside ul {
			display: flex;
			flex-wrap: wrap;
		}

		.prose {
			grid-column: 1;
		}
	}

	@media (max-width: 650px) {
		.case-hero__meta {
			grid-template-columns: 1fr auto;
		}

		.case-hero__meta span:last-child {
			display: none;
		}

		.case-hero h1 {
			font-size: clamp(3.6rem, 16vw, 5.25rem);
		}

		.case-hero__facts dl {
			grid-template-columns: 1fr;
		}

		.case-hero__facts dl div,
		.case-hero__facts dl div:first-child {
			padding: 0.75rem 0;
			border-right: 0;
			border-bottom: 1px solid var(--grey-300);
		}

		.case-hero__facts dl div:last-child {
			border-bottom: 0;
		}
	}
</style>

<script>
	function initDeviceCarousels() {
		document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
			if (carousel.dataset.carouselInit) return;
			carousel.dataset.carouselInit = 'true';

			const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
			const dots = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-dot]'));
			const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
			const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');

			if (slides.length < 2) return;

			let current = 0;

			const show = (index: number) => {
				current = (index + slides.length) % slides.length;
				slides.forEach((slide, i) => {
					slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
				});
				dots.forEach((dot, i) => {
					dot.setAttribute('aria-hidden', i === current ? 'false' : 'true');
				});
			};

			prevBtn?.addEventListener('click', () => show(current - 1));
			nextBtn?.addEventListener('click', () => show(current + 1));

			let touchStartX = 0;
			let touchStartY = 0;
			let touchActive = false;

			carousel.addEventListener(
				'touchstart',
				(event) => {
					if (event.touches.length !== 1) return;
					touchActive = true;
					touchStartX = event.touches[0].clientX;
					touchStartY = event.touches[0].clientY;
				},
				{ passive: true }
			);

			carousel.addEventListener(
				'touchend',
				(event) => {
					if (!touchActive) return;
					touchActive = false;
					const touch = event.changedTouches[0];
					const deltaX = touch.clientX - touchStartX;
					const deltaY = touch.clientY - touchStartY;

					const SWIPE_THRESHOLD = 40;
					if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
						show(deltaX < 0 ? current + 1 : current - 1);
					}
				},
				{ passive: true }
			);
		});
	}

	initDeviceCarousels();
	document.addEventListener('astro:page-load', initDeviceCarousels);

	function initVideoFacades() {
		document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((facade) => {
			if (facade.dataset.videoInit) return;
			facade.dataset.videoInit = 'true';

			const playBtn = facade.querySelector<HTMLButtonElement>('[data-video-play]');
			const src = facade.dataset.videoSrc;

			playBtn?.addEventListener('click', () => {
				if (!src) return;

				const url = new URL(src);
				url.searchParams.set('autoplay', '1');
				url.searchParams.set('mute', '1');
				url.searchParams.set('enablejsapi', '1');
				url.searchParams.set('origin', window.location.origin);

				const iframe = document.createElement('iframe');
				iframe.src = url.toString();
				iframe.title = playBtn.querySelector('.sr-only')?.textContent ?? 'Video';
				iframe.loading = 'eager';
				iframe.referrerPolicy = 'strict-origin-when-cross-origin';
				iframe.allow =
					'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
				iframe.allowFullscreen = true;
				iframe.setAttribute('playsinline', '1');
				iframe.style.width = '100%';
				iframe.style.height = '100%';
				iframe.style.border = '0';
				iframe.style.display = 'block';

				facade.replaceChildren(iframe);

				// Mobile Chrome only grants autoplay with sound when a video
				// starts muted, so it's started muted above and then unmuted
				// via the YouTube postMessage API once the player is ready.
				const unmute = () => {
					iframe.contentWindow?.postMessage(
						JSON.stringify({ event: 'command', func: 'unMute', args: [] }),
						'*',
					);
					iframe.contentWindow?.postMessage(
						JSON.stringify({ event: 'command', func: 'playVideo', args: [] }),
						'*',
					);
				};

				iframe.addEventListener('load', () => {
					// Give the YouTube player a moment to initialise before
					// sending commands, then retry briefly in case the first
					// message arrives before the player is listening.
					setTimeout(unmute, 300);
					setTimeout(unmute, 800);
					setTimeout(unmute, 1500);
				});
			});
		});
	}

	initVideoFacades();
	document.addEventListener('astro:page-load', initVideoFacades);
</script>
